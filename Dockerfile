# Stage 1: Build
FROM node:18-alpine as build
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .

# Project environment variables for aura-ai-hypen
# Context: dev
# Scope: any
# Date: Wed, 27 May 2026 07:30:44 GMT

# --- ADD THESE LINES ---
# 1. Declare the arguments (these can be passed during the Docker build command, e.g., --build-arg REACT_APP_API_URL=...)
#    In Cloud Build, these will receive values from the "Build arguments" field, which in turn
#    get values from Cloud Build's "Substitution variables".
ARG CI
ARG GENERATE_SOURCEMAP
ARG NODE_OPTIONS

ARG REACT_APP_API_URL
ARG REACT_APP_APPID
ARG REACT_APP_ARSONGS_AI_API_URL
ARG REACT_APP_AUTHDOMAIN
ARG REACT_APP_CHECK_RUNNING_STATUS
ARG REACT_APP_DEFAULT_USER_ORG_ID
ARG REACT_APP_DEFAULT_USER_UID
ARG REACT_APP_FILE_CDN_URL
ARG REACT_APP_FILE_CDN_URL_2
ARG REACT_APP_FIREBASE_API_KEY
ARG REACT_APP_FIREBASE_APP_ID
ARG REACT_APP_FIREBASE_AUTH_DOMAIN
ARG REACT_APP_FIREBASE_MEASUREMENT_ID
ARG REACT_APP_FIREBASE_MESSAGING_SENDER_ID
ARG REACT_APP_FIREBASE_PROJECT_ID
ARG REACT_APP_FIREBASE_STORAGE_BUCKET
ARG REACT_APP_SECRET_KEY
ARG REACT_APP_STORAGEBUCKET
ARG REACT_APP_SUPER_ADMIN_EMAIL

# 2. Assign them to Environment Variables so React can see them during 'npm run build'
#    React (or Vite) will then "bake" these values into the compiled JavaScript.
ENV CI=$CI
ENV GENERATE_SOURCEMAP=$GENERATE_SOURCEMAP
ENV NODE_OPTIONS=$NODE_OPTIONS

ENV REACT_APP_API_URL=$REACT_APP_API_URL
ENV REACT_APP_APPID=$REACT_APP_APPID
ENV REACT_APP_ARSONGS_AI_API_URL=$REACT_APP_ARSONGS_AI_API_URL
ENV REACT_APP_AUTHDOMAIN=$REACT_APP_AUTHDOMAIN
ENV REACT_APP_CHECK_RUNNING_STATUS=$REACT_APP_CHECK_RUNNING_STATUS
ENV REACT_APP_DEFAULT_USER_ORG_ID=$REACT_APP_DEFAULT_USER_ORG_ID
ENV REACT_APP_DEFAULT_USER_UID=$REACT_APP_DEFAULT_USER_UID
ENV REACT_APP_FILE_CDN_URL=$REACT_APP_FILE_CDN_URL
ENV REACT_APP_FILE_CDN_URL_2=$REACT_APP_FILE_CDN_URL_2
ENV REACT_APP_FIREBASE_API_KEY=$REACT_APP_FIREBASE_API_KEY
ENV REACT_APP_FIREBASE_APP_ID=$REACT_APP_FIREBASE_APP_ID
ENV REACT_APP_FIREBASE_AUTH_DOMAIN=$REACT_APP_FIREBASE_AUTH_DOMAIN
ENV REACT_APP_FIREBASE_MEASUREMENT_ID=$REACT_APP_FIREBASE_MEASUREMENT_ID
ENV REACT_APP_FIREBASE_MESSAGING_SENDER_ID=$REACT_APP_FIREBASE_MESSAGING_SENDER_ID
ENV REACT_APP_FIREBASE_PROJECT_ID=$REACT_APP_FIREBASE_PROJECT_ID
ENV REACT_APP_FIREBASE_STORAGE_BUCKET=$REACT_APP_FIREBASE_STORAGE_BUCKET
ENV REACT_APP_SECRET_KEY=$REACT_APP_SECRET_KEY
ENV REACT_APP_STORAGEBUCKET=$REACT_APP_STORAGEBUCKET
ENV REACT_APP_SUPER_ADMIN_EMAIL=$REACT_APP_SUPER_ADMIN_EMAIL
# -----------------------

RUN npm run build

# Stage 2: Serve
FROM nginx:alpine
# Copy the build output to replace the default nginx contents.
COPY --from=build /app/build /usr/share/nginx/html
# Copy custom nginx config for React Router support
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
